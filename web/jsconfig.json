{
  "compilerOptions": {
    "target": "ES2020",
    // The code already uses ES2022 APIs (Array.prototype.at, Object.hasOwn, replaceAll).
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    // Don't type-check untyped JS inside dependencies (e.g. sortablejs).
    "maxNodeModuleJsDepth": 0,

    /* Preact Config */
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true,
    "paths": {
      "react": ["./node_modules/preact/compat/"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react-dom": ["./node_modules/preact/compat/"],
      "react-dom/*": ["./node_modules/preact/compat/*"]
    }
  },
  "include": ["node_modules/vite/client.d.ts", "src", "test"]
}
